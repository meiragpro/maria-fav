---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';

// Ranked posts lead, in rank order; everything else falls back to newest first.
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => {
  const ra = a.data.rank ?? Infinity;
  const rb = b.data.rank ?? Infinity;
  if (ra !== rb) return ra - rb;
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});
const ranked = posts.filter((p) => p.data.rank !== undefined);
---

<Layout>
  <section class="intro">
    <p class="eyebrow">The Verdicts</p>
    <h1>Ship or Skip</h1>
    <p class="lede">
      Every product here gets bought, used, and given a straight verdict. If it's
      not worth your money, it gets a Skip — even when the link pays me.
    </p>
  </section>

  {ranked.length > 0 && (
    <section class="ranked-intro">
      <h2>The K-beauty trio, ranked</h2>
      <p>
        Three Korean serums, all of which earned a Ship — but they are not equal.
        Ranked by how much they actually changed my skin, best first.
      </p>
      <ol class="ranked-list">
        {ranked.map((post) => (
          <li>
            <a href={`/posts/${post.slug}/`}>{post.data.title}</a>
            {post.data.rankNote && <span> — {post.data.rankNote}</span>}
          </li>
        ))}
      </ol>
    </section>
  )}

  <section class="grid">
    {posts.map((post) => (
      <ProductCard
        title={post.data.title}
        description={post.data.description}
        image={post.data.image}
        href={`/posts/${post.slug}/`}
        amazonUrl={post.data.amazonUrl}
        price={post.data.price}
        rating={post.data.rating}
        verdict={post.data.verdict}
        rank={post.data.rank}
        rankNote={post.data.rankNote}
      />
    ))}
  </section>
</Layout>

<style>
  .intro { text-align: center; padding: 1.5rem 0 3rem; }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.75rem;
    color: var(--accent);
    margin: 0 0 0.6rem;
    font-weight: 600;
  }
  .intro h1 {
    font-family: var(--serif);
    font-size: 3rem;
    font-weight: 600;
    margin: 0 0 0.8rem;
    line-height: 1.1;
  }
  .lede { color: var(--muted); max-width: 540px; margin: 0 auto; font-size: 1.05rem; }

  .ranked-intro {
    max-width: 680px;
    margin: 0 auto 3rem;
    padding: 1.6rem 1.8rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 20px;
  }
  .ranked-intro h2 {
    font-family: var(--serif);
    font-size: 1.6rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
  }
  .ranked-intro > p { color: var(--muted); margin: 0 0 1.1rem; font-size: 0.98rem; }
  .ranked-list { margin: 0; padding-left: 1.3rem; }
  .ranked-list li { margin-bottom: 0.6rem; line-height: 1.5; }
  .ranked-list li::marker { font-family: var(--serif); font-weight: 600; color: var(--accent-dark); }
  .ranked-list a { font-weight: 600; text-decoration: none; }
  .ranked-list a:hover { text-decoration: underline; }
  .ranked-list span { color: var(--muted); font-size: 0.93rem; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 2rem;
  }
</style>
